{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/agri",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ja/agri",
      "destination": "/ja",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
